# ── Coast environment ─────────────────────────────────────────────
# Copy to .env.local and fill in. NEVER commit real values.

# Supabase (create a free project at https://supabase.com, then run
# supabase/migrations/001_schema.sql in the SQL editor)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Plaid (sandbox first — sign up free at https://dashboard.plaid.com,
# then paste the sandbox keys here; production keys come later)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Optional: public URL of the deployed app (used for share-card links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
